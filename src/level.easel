pub signal this.BeginLevel(count)

pub fn this.Level([owner]) {

    on BeginLevel count {
        if count == 0 {
            Level0
        } else if count == 1 {
            Level1
        } else if count == 2 {
            Level2
        }
    }

}

pub fn this.Level0 {
    once Tick {
        Spawn powerup {
            Powerup(pos=@(-10, -5), type=MultiLaser)
        }
        Spawn asteroid {
            Asteroid
        }
        Spawn powerup {
            Powerup(pos=@(10, -5), type=UpgradeThruster)
        }
        Spawn powerup {
            Powerup(pos=@(30, -5), type=AddFireRate)
        }
        Spawn powerup {
            Powerup(pos=@(-10, 5), type=HealthPickup)
        }
    }
}

signal this.EndAsteroids
signal this.FirstWaveCleared

pub fn this.Level1([owner]) {

    // Music(@assets/bgm1.mp3, volume=0.5, loop=true)
    
    once Tick {
        OverlayContent<levelTitle> {
            VStack(align=Align:Center) {
                Standout(fontSize=5) { FlyInWords("Level 1") }
            }
        }
    }
    
    once Tick(3s) {
        delete OverlayContent<levelTitle>
    }

    await Tick(3s)

    once Tick(25s) {
        EndAsteroids
    }
    
    behavior<shower> on Tick(1s) {
        const MaxAsteroids = 10
        if QueryCount(filter=Category:Asteroid) < MaxAsteroids {
            Spawn asteroid {
                Asteroid(speed=10*Random+10)
            }
        }
    }

    on EndAsteroids {
        delete behavior<shower>
    }
    
    await EndAsteroids

    with Tick(3s) {
        const MaxAsteroids = 3
        if QueryCount(filter=Category:Asteroid) < MaxAsteroids {
            Spawn asteroid {
                Asteroid
            }
        }
    }

    for index in Range(0,3) {
        let lvl = this
        Spawn ship {
            EnemyDrone(ship)
            RoleCatious(ship)
            on BeforeDespawn {
                if QueryCount(filter=Category:Enemy) <= 1 {
                    lvl.FirstWaveCleared
                }
            }
        }
    }

    await FirstWaveCleared
    await Tick(3s)
    
    with Tick(3s) {
        const MaxEnemies=4
        if QueryCount(filter=Category:Enemy) < MaxEnemies {
            Spawn ship {
                EnemyFighter(ship)
                RoleCatious(ship, ship.speed)
            }
        }
    }
}

pub fn this.Level2 {
    once Tick {
        OverlayContent<level2Title> {
            VStack(align=Align:Center) {
                Standout(fontSize=5) { FlyInWords("Level 2") }
            }
        }
    }

    once Tick(3s) {
        delete OverlayContent<level2Title>
    }
}
