pub tangible category Category:Projectile

pub fn this.ShotgunBomb(body) {
    const angle = 0.02rev
    let initial = -(angle * (5 - 1)) / 2
    for index in Range(0, 5) {
        Spawn projectile {
            Bubble(source=body, offset=initial + index * angle)
        }
    }
}

pub fn projectile.Bomb(ship, target) {
    use body=projectile
    use speed=12
    use radius=0.5
    use turnRate=0.1rev
    use color=#7f6a03
    use luminous=1
    use layer=4
    use lifetime=1s * Distance(ship.Pos, target) / speed

    Body(bullet=true, pos=ship.Pos, velocity=speed*Direction(target-pos))

    PolygonCollider(shape=Circle, category=Category:Projectile, collideWith=Category:Ship | Category:Projectile | Category:Asteroid | Category:Weapon)
    PolygonSprite(shape=Circle, glare=0.7, bloom=3)

    DespawnBounds
    
    once Tick(lifetime) { Expire }

    once BeforeCollide that {
        Strobe(shine=1, dissipate=0.5s)
        Explode(body, radius)
        Expire
    }

    once BeforeDespawn {
        Spark(radius=6, dissipate=0.5s, shine=0.2, bloom=3, feather=1, glare=0.3)

        Spawn explosion {
            Explosion(pos=Pos)
        }
        Hear(@effects/explode_small.esfx)
    }
}

pub fn projectile.Cannon(source, offset=0) {
    use body=projectile
    use radius=0.25
    use layer=4
    use speed=50
    use color=#7f6a03
    use luminous=1

    Body(bullet=true, pos=source.Pos, velocity=speed * Direction(source.Heading + offset))
    PolygonCollider(shape=Circle, category=Category:Projectile, parent=source, collideWith=Category:Ship | Category:Projectile | Category:Asteroid)

    on Paint {
        Streak(dissipate=0.05s, bloom=1, ownerColor=1, bloomAlpha=0.5, glare=0.3)
    }

    once BeforeCollide that {
        Strobe(shine=1, dissipate=0.5s)
        repeat 5 { Spark(shine=0.5, splatter=1, dissipate=0.5s) }
        
        Expire
    }

    once Tick(1.5s) { Expire }
}

pub fn projectile.Bubble(source, offset=0) {
    use body=projectile
    use radius=0.5
    use layer=4
    use speed=12
    use velocity = speed * Direction(source.Heading + offset)
    use color=#7f6a03
    use luminous=1

    Body(bullet=true, pos=source.Pos, velocity=)
    PolygonCollider(shape=Circle, category=Category:Projectile, parent=source, collideWith=Category:Ship | Category:Projectile | Category:Asteroid)
    PolygonSprite(shape=Circle, glare=0.7, bloom=3)

    once BeforeCollide that {
        Strobe(shine=1, dissipate=0.5s)
        repeat 5 { Spark(shine=0.5, splatter=1, dissipate=0.5s) }
        
        Expire
    }

    once Tick(5s) { Expire }
}

